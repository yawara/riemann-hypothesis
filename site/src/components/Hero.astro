---
// 巻頭。左に ζ の位相図(複素平面のふつうの向き: 横が Re s、縦が Im s)、右に縦組みの題字。
// 図版は scripts/gen_zeta_phase.py が描いたもの。高さがちょうど Im s の範囲になるように置き、
// 臨界線と零点の数値は、その座標に合わせて重ねる(位置は割合で決まるので JavaScript は使わない)。
import { getImage } from 'astro:assets';
import M from './M.astro';
import lightPng from '../assets/zeta-hero-light.png';
import darkPng from '../assets/zeta-hero-dark.png';
import geo from '../assets/zeta-hero.json';

interface Props {
  /** 題字。縦組みで、1 行目が右に来る */
  lines: string[];
}
const { lines } = Astro.props;
// 透明度つきの大きな図版なので、AVIF を優先し(約 1/3 の大きさ)、WebP を予備にする
const lightAvif = await getImage({ src: lightPng, format: 'avif', quality: 62 });
const darkAvif = await getImage({ src: darkPng, format: 'avif', quality: 62 });
const light = await getImage({ src: lightPng, format: 'webp', quality: 76 });
const dark = await getImage({ src: darkPng, format: 'webp', quality: 76 });
const span = geo.tMax - geo.tMin;
const line = (geo.sigMax - 0.5) / span; // 臨界線の位置(右端から、高さに対する割合)
---

<div class="hero bleed" style={`--line:${line}`}>
  <div class="hero-art" role="img" aria-label="リーマンゼータ関数の偏角を色で表した図。零点が 6 個、縦の直線 Re s = 1/2 の上に並んでいる。">
    <div class="hero-plate">
      <picture>
        <source type="image/avif" srcset={darkAvif.src} media="(prefers-color-scheme: dark)" />
        <source type="image/avif" srcset={lightAvif.src} />
        <source type="image/webp" srcset={dark.src} media="(prefers-color-scheme: dark)" />
        <img src={light.src} width={light.attributes.width} height={light.attributes.height} alt="" decoding="async" fetchpriority="high" />
      </picture>
    </div>
    <span class="hero-line"></span>
    <span class="hero-axis"><M tex={String.raw`\operatorname{Re} s = \tfrac12`} /></span>
    {
      geo.zeros.map((g: number) => (
        <span class="hero-zero" style={`bottom:${(((g - geo.tMin) / span) * 100).toFixed(3)}%`}>
          {g.toFixed(6)}
        </span>
      ))
    }
  </div>
  <h1 class="hero-title font-display">
    {lines.map((l) => <span class="block">{l}</span>)}
  </h1>
</div>
