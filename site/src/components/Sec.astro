---
// 節。見出しは太明朝(解星 特ミン)。広い画面では節番号(Computer Modern の数字、藍)を左余白にぶら下げる。
interface Props {
  id: string;
  no: string;
  title: string;
}
const { id, no, title } = Astro.props;
---

<section id={id} aria-labelledby={`h-${id}`}>
  <h2 id={`h-${id}`} class="sec-head mb-5 font-display text-[1.55rem] leading-[1.42] font-extrabold tracking-[0.02em]">
    <span class="font-serif text-[2rem] leading-none font-normal tracking-normal text-ai wide:pr-4 wide:text-right" aria-hidden="true">{no}</span>
    <span class="text-balance"><span class="sr-only">{no} </span>{title}</span>
  </h2>
  <div class="honbun flow-root">
    <slot />
  </div>
</section>
