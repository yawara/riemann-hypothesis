---
// 「項目名 — 値」の表。値は信頼できる固定の HTML(リンクや <code> を含む)。
import Tbl from './Tbl.astro';

interface Props {
  rows: [string, string][];
  no?: string;
  title?: string;
}
const { rows, no, title } = Astro.props;
---

<Tbl no={no} title={title}>
  <tbody>
    {
      rows.map(([k, v]) => (
        <tr>
          <th class="w-[7.5rem] sm:w-[9.5rem]">{k}</th>
          <td set:html={v} />
        </tr>
      ))
    }
  </tbody>
</Tbl>
