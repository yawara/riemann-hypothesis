---
// 冒頭の図: 臨界線上のリーマン ζ 関数(Hardy の Z 関数)と、その零点。
// 描画は Observable Plot。値は scripts/gen_zeta_figure.py で計算し、零点は既知の値と照合済み。
import M from './M.astro';
import Table from './Table.astro';
import data from '../data/generated.json';

const zeros = data.zeta.zeros;
---

<figure class="flex flex-col gap-3">
  <div
    id="zplot"
    class="min-h-[170px] w-full text-base-content"
    role="img"
    aria-label="臨界線上のリーマンゼータ関数 Z(t) のグラフ。t が 0 から 60 までの範囲に零点が 13 個ある。"
  >
    <noscript>
      <p class="py-10 text-center text-sm text-base-content/70">図の表示には JavaScript が必要です。零点の値は下の表にあります。</p>
    </noscript>
  </div>
  <figcaption class="max-w-3xl text-sm leading-[1.8] text-base-content/70">
    臨界線 <M tex={String.raw`\operatorname{Re} s = \tfrac12`} /> の上でのリーマン ζ 関数。横軸は <M tex={String.raw`s = \tfrac12 + it`} /> の
    <M tex={String.raw`t`} />、縦軸は Hardy の Z 関数 <M tex={String.raw`Z(t)`} /> で、絶対値は <M tex={String.raw`|\zeta(\tfrac12 + it)|`} />
    に等しくなります。曲線が横軸を横切る点が非自明な零点で、<M tex={String.raw`t \le 60`} /> の範囲に 13
    個あります。リーマン予想は、非自明な零点がすべてこの直線上にあるという主張です。図の値は本リポジトリのスクリプトで計算し、零点は既知の値と小数
    6 桁まで照合しました。
  </figcaption>
  <details class="collapse collapse-arrow max-w-md border border-base-300 bg-base-100">
    <summary class="collapse-title min-h-0 py-2.5 text-sm font-semibold">零点の一覧を表で見る</summary>
    <div class="collapse-content">
      <Table class="table-xs">
        <thead>
          <tr><th class="text-right">番号</th><th class="text-right">零点の虚部 t</th></tr>
        </thead>
        <tbody>
          {
            zeros.map((t, i) => (
              <tr>
                <td class="num">{i + 1}</td>
                <td class="num">{t.toFixed(6)}</td>
              </tr>
            ))
          }
        </tbody>
      </Table>
    </div>
  </details>
</figure>

<script>
  import * as Plot from '@observablehq/plot';
  import data from '../data/generated.json';

  const el = document.getElementById('zplot');
  const { z, step, tMax, zeros } = data.zeta;

  // 曲線の点列。零点そのものも点として混ぜ、カーソルが零点にぴったり合うようにする。
  const curve = z.map((v, i) => ({ t: +(i * step).toFixed(2), z: v, k: 0 }));
  const zeroPts = zeros.map((t, i) => ({ t, z: 0, k: i + 1 }));
  const hover = [...curve, ...zeroPts].sort((a, b) => a.t - b.t);
  const minus = (s) => s.replace('-', '−');

  function draw() {
    if (!el) return;
    const width = el.clientWidth;
    if (!width) return;
    const narrow = width < 560;
    const height = Math.round(Math.max(185, Math.min(265, width * 0.24)));
    const plot = Plot.plot({
      width,
      height,
      marginLeft: 36,
      marginRight: 14,
      marginTop: 28,
      marginBottom: 34,
      style: { background: 'transparent', fontFamily: 'inherit', fontSize: '12px', overflow: 'visible' },
      x: { domain: [0, tMax], ticks: [0, 10, 20, 30, 40, 50, 60], label: 't', labelArrow: 'none', tickSize: 0 },
      y: { domain: [-4, 4], ticks: [-4, -2, 0, 2, 4], label: 'Z(t)', labelAnchor: 'top', labelArrow: 'none', tickSize: 0, tickFormat: (d) => minus(String(d)) },
      marks: [
        Plot.gridX([10, 20, 30, 40, 50], { stroke: 'var(--rh-hair)', strokeOpacity: 1 }),
        Plot.gridY([-4, -2, 2, 4], { stroke: 'var(--rh-hair)', strokeOpacity: 1 }),
        Plot.ruleY([0], { stroke: 'var(--color-base-300)', strokeWidth: 1.5 }),
        Plot.lineY(curve, { x: 't', y: 'z', stroke: 'var(--rh-series)', strokeWidth: 2, strokeLinejoin: 'round', strokeLinecap: 'round' }),
        Plot.dot(zeroPts, { x: 't', y: 'z', r: 4.5, fill: 'var(--rh-series)', stroke: 'var(--color-base-200)', strokeWidth: 2 }),
        Plot.text([zeroPts[0]], {
          x: 't',
          y: 'z',
          text: () => (narrow ? 't ≈ 14.13' : '最初の零点 t ≈ 14.13'),
          textAnchor: 'end',
          dx: -9,
          dy: -13,
          fill: 'currentColor',
          fillOpacity: 0.7,
        }),
        Plot.ruleX(hover, Plot.pointerX({ x: 't', stroke: 'currentColor', strokeOpacity: 0.45 })),
        Plot.dot(hover, Plot.pointerX({ x: 't', y: 'z', r: 4.5, fill: 'var(--rh-series)', stroke: 'var(--color-base-200)', strokeWidth: 2 })),
        Plot.tip(
          hover,
          Plot.pointerX({
            x: 't',
            y: 'z',
            title: (d) => (d.k ? `第 ${d.k} 零点\nt = ${d.t.toFixed(6)}` : `Z(t) = ${minus(d.z.toFixed(3))}\nt = ${d.t.toFixed(2)}`),
            fill: 'var(--color-base-100)',
            stroke: 'var(--color-base-300)',
            fontSize: 12,
            lineHeight: 1.35,
          }),
        ),
      ],
    });
    el.replaceChildren(plot);
  }

  if (el) {
    draw();
    let last = el.clientWidth;
    new ResizeObserver(() => {
      if (el.clientWidth !== last) {
        last = el.clientWidth;
        draw();
      }
    }).observe(el);
  }
</script>
