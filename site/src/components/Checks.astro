---
// 検査の一覧。進行順に並ぶので daisyUI の timeline(縦・片側寄せ)で示す。
import CheckCircle from 'heroicons/20/solid/check-circle.svg';
import Clock from 'heroicons/20/solid/clock.svg';
import XCircle from 'heroicons/20/solid/x-circle.svg';
import Status from './Status.astro';

export interface Check {
  state: 'ok' | 'run' | 'wait' | 'bad';
  label: string;
  title: string;
  detail: string; // 信頼できる固定の HTML(インラインの <code> を含む)
}
interface Props {
  items: Check[];
}
const { items } = Astro.props;
---

<ul class="timeline timeline-vertical timeline-compact">
  {
    items.map((c, i) => (
      <li class="[--timeline-row-start:0.5rem]">
        {i > 0 && <hr class:list={[items[i - 1].state === 'ok' && 'bg-primary']} />}
        <div class="timeline-middle">
          {c.state === 'ok' && <CheckCircle class="size-5 text-primary" aria-hidden="true" />}
          {c.state === 'run' && <Clock class="size-5 text-warning" aria-hidden="true" />}
          {c.state === 'bad' && <XCircle class="size-5 text-error" aria-hidden="true" />}
          {c.state === 'wait' && <span class="m-0.5 block size-4 rounded-full border-2 border-base-300 bg-base-100" aria-hidden="true" />}
        </div>
        <div class="timeline-end ms-3 mb-5 w-full">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-bold leading-snug">
            {c.title}
            <Status state={c.state} label={c.label} />
          </div>
          <p class="mt-1 max-w-2xl text-sm leading-[1.75] text-base-content/70 [&_code]:rounded [&_code]:bg-base-200 [&_code]:px-1 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[0.86em]" set:html={c.detail} />
        </div>
        {i < items.length - 1 && <hr class:list={[c.state === 'ok' && 'bg-primary']} />}
      </li>
    ))
  }
</ul>
