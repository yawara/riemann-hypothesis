---
// 検査の状態を印で示す。朱の「済」、藍の「中」(実行中)、灰の「未」(未着手)、墨の角印「否」。
import Seal from './Seal.astro';

interface Props {
  state: 'ok' | 'run' | 'wait' | 'bad';
  /** 印の右に添える短い説明(省略可) */
  label?: string;
  size?: string;
}
const { state, label, size = '1.5rem' } = Astro.props;
const names = { ok: '済', run: '実行中', wait: '未着手', bad: '否' };
---

<span class="inline-flex items-center gap-1.5 align-middle font-sans text-[0.8125rem] leading-none font-normal whitespace-nowrap">
  {state === 'ok' && <Seal text="済" tone="shu" size={size} rotate={-7} label={names.ok} />}
  {state === 'run' && <Seal text="中" tone="ai" size={size} rotate={5} label={names.run} />}
  {state === 'wait' && <Seal text="未" tone="mute" size={size} rotate={0} label={names.wait} />}
  {state === 'bad' && <Seal text="否" tone="ink" shape="square" filled size={size} rotate={-3} label={names.bad} />}
  {label && <span class:list={[state === 'wait' ? 'text-ink-2' : 'text-ink']}>{label}</span>}
</span>
