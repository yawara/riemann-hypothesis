---
// 検証レポート本体。数値・ハッシュはリポジトリの verification/ と evidence/ から転記したもの。
import Report from '../layouts/Report.astro';
import Section from '../components/Section.astro';
import Status from '../components/Status.astro';
import Checks, { type Check } from '../components/Checks.astro';
import BuildProgress from '../components/BuildProgress.astro';
import ZetaPlot from '../components/ZetaPlot.astro';
import CodeFile from '../components/CodeFile.astro';
import Table from '../components/Table.astro';
import Kv from '../components/Kv.astro';
import Note from '../components/Note.astro';
import M from '../components/M.astro';
import data from '../data/generated.json';

const title = 'リーマン予想 Lean 証明の独立検証';
const description =
  'alpo.ge で公開されたリーマン予想の Lean 形式証明(175,187 ファイル・17,374,215 行・約 1.03 GB)を、原本を保全したうえで独立にコンパイル・検査している記録。';

const toc = [
  { id: 'summary', mark: '要旨', title: '現時点の結論' },
  { id: 'target', mark: '§1', title: '検証対象' },
  { id: 'evidence', mark: '§2', title: '原本の保全' },
  { id: 'scale', mark: '§3', title: 'Lean コードの規模' },
  { id: 'statements', mark: '§4', title: '主定理の主張' },
  { id: 'checks', mark: '§5', title: '検査の内容と結果' },
  { id: 'hardware', mark: '§6', title: '検証に使った計算機' },
  { id: 'limits', mark: '§7', title: '言えること・言えないこと' },
  { id: 'reproduce', mark: '§8', title: '再現手順' },
];

const repo = 'https://github.com/yawara/riemann-hypothesis';
const link = (href: string, text: string) => `<a class="link link-primary" href="${href}">${text}</a>`;

// ---- 要旨: 検査の一覧(進行順) ----
const checks: Check[] = [
  { state: 'ok', label: '完了', title: '原本の取得と保全', detail: 'PDF 1 個と Lean 配布物 14 分割を取得し、応答ヘッダ・取得時刻・SHA-256 とともに保存。' },
  { state: 'ok', label: '完了', title: '配布物の完全性', detail: '14 分割を連結すると正常な gzip。中身は通常ファイルのみ 175,190 個で、危険なパスやリンクは無し。' },
  { state: 'ok', label: '完了', title: '依存ライブラリの真正性', detail: '固定された Mathlib のコミットは公式リポジトリのタグ <code>v4.33.1</code> そのもの。他の依存も Mathlib 自身の固定版と一致。' },
  { state: 'ok', label: '0 件', title: 'ソースの静的スキャン', detail: '<code>sorry</code>・<code>axiom</code>・<code>native_decide</code>・<code>unsafe</code>・カーネル検査のスキップ指定などは、全ソース中に 1 件も無し。' },
  { state: 'ok', label: '完了', title: 'import グラフ', detail: '存在しないモジュールへの import は 0、循環は 0。全 175,187 モジュールが <code>Main</code> から到達可能。' },
  { state: 'run', label: '進行中', title: '全モジュールのコンパイル', detail: '2026-11-21 10:42 JST 開始。毎秒 3〜4 モジュールで進行中。完走まで半日程度の見込み。' },
  { state: 'wait', label: '未実施', title: '主定理が依存する公理', detail: 'ビルド完了後に <code>#print axioms</code> で確認。' },
  { state: 'wait', label: '未実施', title: '主張の一致確認', detail: '検証者が Mathlib だけで書いた命題と、主定理の型が一致するかをカーネルに判定させる。' },
  { state: 'wait', label: '未実施', title: 'カーネルによる再検査', detail: 'ツールチェーン同梱の <code>leanchecker</code> で全モジュールの宣言をカーネルに再生させる。' },
  { state: 'wait', label: '未実施', title: '別実装のカーネルによる照合', detail: '主定理の依存一式を書き出し、Rust 製の別実装カーネル <code>nanoda</code> で検査する。道具は準備済みで、小さな対象では動作を確認。' },
  { state: 'wait', label: '未実施', title: 'ビルド後のソース不変確認', detail: 'ビルドに使った全ファイルが原本と 1 バイトも違わないことを再照合する。' },
];

// ---- §1 ----
const targetRows: [string, string][] = [
  ['起点の文書', `${link('https://alpo.ge/remark.pdf', 'https://alpo.ge/remark.pdf')}(4 ページ、作成日時 2026-11-20 21:52:48 JST)`],
  ['Lean コード', '<code>https://alpo.ge/lean.tar.gz.part01</code> 〜 <code>part14</code>(連結すると 1 個の tar.gz)'],
  ['文書の主張', 'リーマン予想と、Dirichlet L 関数に対する一般化リーマン予想の証明。Lean による形式化は完了済み。'],
  ['著者表記', 'PDF 本文にもメタデータにも著者名は書かれていません。配布元は個人ドメイン <code>alpo.ge</code> です。'],
];

// ---- §2 ----
const chain = [
  { t: 'remark.pdf', d: '245,114 バイト。取得 2026-11-21 10:24:45 JST。', hash: '3fc97784b71ddd44ff8aa0a177e99622a1c61b13cfa843a0989ee4a7a0cfeb8d' },
  { t: 'lean.tar.gz.part01 〜 part14', d: 'part01〜13 は各 18,000,000 バイト、part14 は 5,275,554 バイト。取得 2026-11-21 10:25:45〜10:25:50 JST。各分割の SHA-256 は SHA256SUMS に記録。' },
  { t: '連結した lean.tar.gz', d: '239,275,554 バイト。gzip -t 正常。展開後の tar は 1,270,753,280 バイト。', hash: '9631b4f020199e580ba86178cb56c6e9b09f690c2369a80dc4334aa93f49c7fc' },
  { t: '展開した Lean プロジェクト(lean/)', d: '175,190 ファイル。全ファイルの SHA-256 一覧を保存し、ビルドに使うツリーが原本と一致することをスクリプトで照合できます。' },
];

// ---- §3 ----
const dirs: [string, string, string, string, string][] = [
  ['Development', '141,928', '12,232,663', '767,288,236', '81.0%'],
  ['Formalism', '18,254', '3,200,748', '164,903,481', '10.4%'],
  ['GroundTheory', '8,507', '1,119,138', '54,564,791', '4.9%'],
  ['ReciprocityTheory', '3,845', '563,016', '28,914,051', '2.2%'],
  ['CompanionTheory', '2,027', '194,218', '11,296,366', '1.2%'],
  ['PositivityTheory', '449', '55,130', '3,109,326', '0.3%'],
  ['Lemmata', '167', '9,232', '452,342', '0.1%'],
  ['BuildAid', '5', '20', '850', '0.0%'],
  ['Supplements', '3', '22', '1,195', '0.0%'],
  ['(直下)Main.lean, Statements.lean', '2', '28', '1,216', '0.0%'],
];
const sizeRows: [string, string][] = [
  ['Lean ソースの合計', '<b>1,030,531,854 バイト</b>(約 1.03 GB、983 MiB)。<code>.lean</code> ファイル 175,187 個の合計'],
  ['行数の合計', '<b>17,374,215 行</b>(改行の数)'],
  ['配布アーカイブ', '239,275,554 バイト(約 239 MB)。gzip 圧縮された 14 分割の合計'],
  ['展開後の tar', '1,270,753,280 バイト(約 1.27 GB)'],
  ['展開後のディスク占有', '約 1.4 GB(4 KiB ブロック単位。XFS 上での実測)'],
  ['1 ファイルあたりの行数', '平均 99.2 行、中央値 58 行、90% 点 233 行、99% 点 560 行、最大 17,981 行'],
  ['1 ファイルあたりのサイズ', '平均 5,882 バイト、中央値 3,478 バイト、90% 点 13,268 バイト、99% 点 31,395 バイト、最大 913,995 バイト'],
  ['最大のファイル', '<code>Formalism/HermitianCurvature/HermitianCurvatureProofs/IsAdmissibleSplittingCharPairMulTwist.lean</code>(17,981 行、913,995 バイト)'],
  ['Mathlib 本体との比', 'Mathlib v4.33.1 は 8,311 ファイル・2,293,877 行・97,067,375 バイト。本配布物はファイル数で約 21 倍、行数で約 7.6 倍、バイト数で約 10.6 倍'],
];
const toolRows: [string, string][] = [
  ['Lean', '<code>leanprover/lean4:v4.33.1</code>(配布物の <code>lean-toolchain</code> の指定どおり)'],
  ['ビルドツール', 'Lake 5.0.0-src+819816b(ツールチェーン同梱)'],
  ['Mathlib', 'コミット <code>0df444a360ea…</code>。公式リポジトリのタグ <code>v4.33.1</code>(2026-08-21)と一致'],
  ['外部への import', '<code>Mathlib</code>(136,003 ファイルが全体を import)、<code>Batteries</code>、<code>Lean</code> のみ'],
];

// ---- §4 ----
const theorems: [string, string][] = [
  ['riemannHypothesis', 'Mathlib が定義する <code>RiemannHypothesis</code> そのもの。ζ(s) = 0 で、s が自明な零点(−2, −4, …)でも 1 でもなければ Re s = 1/2。'],
  ['riemannZeta_eq_zero_re', '同じ主張を、Mathlib の定義名を使わずに書き下したもの。'],
  ['LFunction_ne_zero_of_half_lt_re', '一般化リーマン予想(半平面形)。任意の法 N の Dirichlet 指標 χ について、Re s &gt; 1/2 なら L(s, χ) ≠ 0。'],
  ['LFunction_eq_zero_re', '一般化リーマン予想(臨界帯形)。0 &lt; Re s &lt; 1 にある L(s, χ) の零点は Re s = 1/2 上にある。'],
  ['LFunction_eq_zero_re_of_isPrimitive', '上と同じ主張を原始指標に限ったもの。'],
];

// ---- §5.1 ----
const scan: [string, string, string, string][] = [
  ['<code>sorry</code>(大文字小文字無視・部分一致)', '0', '0', '証明の穴埋め'],
  ['<code>admit</code>', '0', '0', '同上'],
  ['<code>axiom</code>', '0', '0', '独自公理の追加'],
  ['<code>native_decide</code> / <code>ofReduceBool</code> / <code>trustCompiler</code>', '0', '0', 'コンパイラを信頼する証明'],
  ['<code>unsafe</code> / <code>implemented_by</code> / <code>extern</code> / <code>opaque</code>', '0', '0', 'カーネル外の実装への差し替え'],
  ['<code>debug.skipKernelTC</code> ほか <code>set_option debug.*</code>', '0', '0', 'カーネル検査のスキップ'],
  ['<code>#guard_msgs</code> / <code>#eval</code> / <code>initialize</code>', '0', '0', 'エラーの握りつぶし、ビルド時のコード実行'],
  ['<code>syntax</code> / 大域の <code>notation</code>', '0', '0', '識別子や記法のすり替え(<code>local</code> / <code>scoped</code> な記法は 1,791 件あり、いずれもファイル内・名前空間内に限定)'],
  ['<code>addDecl</code>', '1', '2', '宣言を別名で複製するコマンド。通常のカーネル検査を通る経路を使用(下記)'],
  ['<code>run_cmd</code> / <code>modifyEnv</code>', '5', '5', '<code>BuildAid/D1〜D5.lean</code>。補題検索の除外リストに名前を足すだけ'],
  ['<code>elab</code>', '3', '4', '証明補助のタクティク定義(下記)'],
  ['<code>macro</code>', '64', '87', 'タクティクの略記。全件が <code>tactic</code> か局所的な項マクロ'],
];

// ---- §5.3 ----
const b = data.build;
const buildRows: [string, string][] = [
  ['開始', '2026-11-21 10:42:23 JST'],
  ['進捗', '冒頭の「全体ビルドの進捗」を参照(自動集計)'],
  ['エラー', b.errors === null || b.errors === undefined ? '集計なし' : `${b.stamp} 時点で ${b.errors} 件` + (b.errors === 0 ? '(リンタの警告のみ)' : '')],
  ['並列度', 'Lean プロセス約 90 並列、ロードアベレージ約 150'],
];

// ---- §6 ----
const hardware: [string, string][] = [
  ['CPU', 'AMD EPYC 7742(64 コア / 128 スレッド、1 ソケット、x86_64、最大 3.41 GHz)'],
  ['キャッシュ', 'L1d 2 MiB / L1i 2 MiB / L2 32 MiB / L3 256 MiB、NUMA 4 ノード'],
  ['メモリ', '528,177,132 kB(約 503 GiB)、スワップ 8 GiB'],
  ['マザーボード', 'TYAN S8030GM4NE-2T(BIOS V2.00、2021-03-11)'],
  ['ストレージ', 'NVMe SSD Seagate FireCuda 510 2 TB(XFS)。ソースは <code>/home</code>、ビルド生成物は <code>/</code> 側に配置'],
  ['OS', 'Ubuntu 24.04.4 LTS、Linux 7.0.0-28-generic'],
  ['ツール', 'elan 4.2.3、Lean 4.33.1、Lake 5.0.0、git 2.43.0、curl 8.5.0、GNU tar 1.35、ripgrep 13.0.0、Python 3.12.3'],
];

// ---- §8 ----
const reproduce = `git clone https://github.com/yawara/riemann-hypothesis.git
cd riemann-hypothesis

scripts/reconstruct.sh                 # 原本 14 分割から lean/ を再構成し、全ファイルのハッシュを照合
scripts/static_scan.sh                 # 静的スキャン
python3 -I scripts/import_graph.py lean/src verification/import-graph

(cd lean && lake exe cache get)        # Lean 4.33.1 と Mathlib v4.33.1(ビルド済みキャッシュ)を取得
scripts/build.sh                       # 全体ビルド(setup.json の削除スクリプトを並走)
scripts/run_checks.sh                  # 公理の一覧、主張の一致確認、主張の依存解析
scripts/run_leanchecker.sh             # 全モジュールのカーネル再検査
scripts/setup_external_checkers.sh     # lean4export / nanoda / lean4lean を用意
scripts/run_nanoda.sh                  # 主定理の依存一式を別実装カーネル nanoda で検査
scripts/reconstruct.sh --verify        # ビルド後もソースが原本と一致することを確認`;
---

<Report title={title} description={description} toc={toc}>
  <header slot="masthead" class="flex flex-col gap-6">
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-b-2 border-base-content pb-3">
      <p class="font-serif text-[0.95rem] font-bold tracking-[0.18em]">独立検証レポート</p>
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-base-content/70">
        <Status state="run" label="検証中" />
        <span>最終更新 <time class="tabular-nums text-base-content">{data.generatedAt}</time></span>
      </p>
    </div>
    <h1 class="mt-1 font-serif text-[clamp(1.75rem,5.4vw,2.9rem)] leading-[1.32] font-bold text-balance">{title}</h1>
    <p class="max-w-2xl leading-[1.9] text-base-content/70">
      2026 年 11 月 20 日付で <a class="link link-primary" href="https://alpo.ge/remark.pdf">alpo.ge/remark.pdf</a>
      に公開された文書と、そこから配布されている Lean 4 の形式証明を、原本を保全したうえで手元の計算機で再コンパイルし、検査している記録です。
    </p>
    <dl class="grid grid-cols-[auto_minmax(0,1fr)] items-baseline gap-x-5 gap-y-2 border-y border-base-300 py-4">
      <dt class="font-serif text-xs font-bold tracking-[0.14em] text-base-content/70">予想</dt>
      <dd class="flex flex-wrap gap-x-[0.9em] text-[clamp(1.02rem,3.1vw,1.4rem)] leading-[1.6]">
        <span class="whitespace-nowrap"><M tex={String.raw`\zeta(s)=0,`} /></span>
        <span class="whitespace-nowrap"><M tex={String.raw`s\notin\{-2,-4,-6,\dots\}`} /></span>
        <span class="whitespace-nowrap"><M tex={String.raw`\Longrightarrow\ \operatorname{Re}s=\tfrac12`} /></span>
      </dd>
      <dt class="font-serif text-xs font-bold tracking-[0.14em] text-base-content/70">Lean</dt>
      <dd class="font-mono text-[clamp(0.8rem,2.5vw,1rem)] wrap-anywhere">theorem riemannHypothesis : RiemannHypothesis</dd>
    </dl>
    <ZetaPlot />
  </header>

  <Section id="summary" mark="要旨" title="現時点の結論">
    <div class="not-prose flex flex-col gap-6">
      <div class="stats stats-vertical w-full border border-base-300 bg-base-100 lg:stats-horizontal">
        <div class="stat">
          <div class="stat-title">Lean ファイル</div>
          <div class="stat-value text-[1.75rem]">175,187</div>
          <div class="stat-desc">個(<span class="font-mono">.lean</span>)</div>
        </div>
        <div class="stat">
          <div class="stat-title">行数</div>
          <div class="stat-value text-[1.75rem]">17,374,215</div>
          <div class="stat-desc">行(改行の数)</div>
        </div>
        <div class="stat">
          <div class="stat-title">ソースの合計サイズ</div>
          <div class="stat-value text-[1.75rem]">1.03 GB</div>
          <div class="stat-desc">1,030,531,854 バイト</div>
        </div>
        <div class="stat">
          <div class="stat-title">配布アーカイブ</div>
          <div class="stat-value text-[1.75rem]">239 MB</div>
          <div class="stat-desc">gzip 圧縮・14 分割の合計</div>
        </div>
      </div>

      <div class="card border border-base-300 bg-base-100">
        <div class="card-body gap-6">
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
            <Status state="run" label="進行中" size="md" />
            <h3 class="font-serif text-[clamp(1.15rem,3.6vw,1.4rem)] leading-snug font-bold">証明の正否は、まだ判定できません</h3>
          </div>
          <p class="max-w-3xl leading-[1.9]">
            配布物の取得・保全と、コンパイル前に行える検査はすべて終わり、いずれも問題は見つかっていません。ただし決定的な検査である「全
            175,187
            ファイルのコンパイル」「主定理が依存する公理の確認」「カーネルによる再検査」「別実装のカーネルによる照合」はこれからです。これらが終わるまで、この証明が正しいとも誤りとも言えません。
          </p>
          <BuildProgress />
          <Checks items={checks} />
        </div>
      </div>
    </div>
  </Section>

  <Section id="target" mark="§1" title="検証対象">
    <p>
      起点は 4 ページの PDF です。本文は、著者が Claude
      と共同でリーマン予想の証明を発見し、さらに一般化リーマン予想まで解決したと述べ、議論を「仮定なしに」形式化したとしています。人間が読める証明文書は公開されておらず、提示されているのは
      Lean のコードだけです。コードの所在は脚注 1 に 14 個の URL として書かれています。
    </p>
    <Kv rows={targetRows} />
    <p class="text-sm text-base-content/70">
      この検証は「配布された Lean コードが、Lean
      の検査を本当に通るか」「通ったとして、それは本当にリーマン予想の主張か」を確かめるものです。証明の数学的な中身を人間が読んで理解・査読する作業は含みません。
    </p>
  </Section>

  <Section id="evidence" mark="§2" title="原本の保全">
    <p>
      取得したファイルはバイト列のままリポジトリの <a href={`${repo}/tree/main/evidence`}><code>evidence/</code></a>
      に保存し、以後いっさい書き換えていません。サーバの応答ヘッダと取得時刻も併せて残しています。
    </p>
    <ul class="not-prose steps steps-vertical my-4 w-full">
      {
        chain.map((c) => (
          <li class="step step-primary">
            <div class="py-3 text-left">
              <div class="font-bold">{c.t}</div>
              <div class="text-sm leading-[1.75] text-base-content/70">{c.d}</div>
              {c.hash && (
                <div class="mt-0.5 text-sm text-base-content/70">
                  SHA-256 <code class="font-mono text-xs break-all text-base-content">{c.hash}</code>
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ul>
    <p>
      tarball の中身は通常ファイルだけで、シンボリックリンクや絶対パス、<code>..</code>
      を含むパスはありません。所有者・時刻は正規化されています(0/0、1970-01-01)。展開ツリーは原本から完全に再構成できるため、git には原本(14
      分割)だけを入れ、展開ツリーは入れていません。
    </p>
  </Section>

  <Section id="scale" mark="§3" title="Lean コードの規模">
    <p>
      配布物に入っている Lean ファイルは <strong>175,187 個</strong>、合計
      <strong>17,374,215 行</strong>、<strong>1,030,531,854 バイト(約 1.03 GB)</strong>です。Lean
      ファイル以外に入っているのは、ビルド設定の 3 ファイル(<code>lakefile.toml</code>、<code>lake-manifest.json</code>、<code
        >lean-toolchain</code
      >)だけです。
    </p>
    <h3>行数とサイズ</h3>
    <Kv rows={sizeRows} />
    <h3>ディレクトリ別の内訳</h3>
    <Table>
      <thead>
        <tr>
          <th>ディレクトリ(<code>lean/src/</code> 直下)</th>
          <th class="text-right">ファイル数</th>
          <th class="text-right">行数</th>
          <th class="text-right">バイト数</th>
          <th class="text-right">ファイル数の割合</th>
        </tr>
      </thead>
      <tbody>
        {
          dirs.map(([name, files, lines, bytes, share]) => (
            <tr>
              <th class="font-semibold whitespace-nowrap">{name}</th>
              <td class="num">{files}</td>
              <td class="num">{lines}</td>
              <td class="num">{bytes}</td>
              <td class="num">{share}</td>
            </tr>
          ))
        }
      </tbody>
      <tfoot>
        <tr class="border-t-2 border-base-300 text-base-content">
          <th class="font-bold">合計</th>
          <td class="num font-bold">175,187</td>
          <td class="num font-bold">17,374,215</td>
          <td class="num font-bold">1,030,531,854</td>
          <td class="num font-bold">100%</td>
        </tr>
      </tfoot>
    </Table>
    <h3>依存関係の形</h3>
    <p>
      各ファイル冒頭の <code>import</code> 行を読んで依存グラフを作ると、プロジェクト内の import は 753,261 本、最長の連鎖は 203
      段でした。<strong>175,187 モジュールのすべてが <code>Main</code> の推移的な import に含まれます。</strong
      >つまり主定理を検査するには、1 ファイルも飛ばさずに全部をコンパイルする必要があります。
    </p>
    <Kv rows={toolRows} />
  </Section>

  <Section id="statements" mark="§4" title="主定理として何が主張されているか">
    <p>
      最終的な主張は、配布物の <code>Main.lean</code> にある 5 つの定理です。そのうち 4 つの命題は <code>Statements.lean</code>
      で定義されています。この <code>Statements.lean</code> は <code>import Mathlib</code>
      だけを行うファイルで、プロジェクト側の定義を一切使っていません。
    </p>
    <CodeFile path="lean/src/Main.lean" note="配布物のまま・全文" code={data.lean.main} />
    <CodeFile path="lean/src/Statements.lean" note="配布物のまま・全文" code={data.lean.statements} />
    <Table>
      <thead>
        <tr><th>定理名</th><th>主張の内容</th></tr>
      </thead>
      <tbody>
        {
          theorems.map(([name, claim]) => (
            <tr>
              <th class="w-2/5 align-top font-normal wrap-anywhere"><code>{name}</code></th>
              <td class="leading-relaxed" set:html={claim} />
            </tr>
          ))
        }
      </tbody>
    </Table>
    <p>
      主張の書き方そのものは、Mathlib の既存の定義(<code>riemannZeta</code>、<code>DirichletCharacter.LFunction</code
      >)に対する標準的な定式化です。主定理の直前の数ファイル(関数等式で左半分を右半分に移す議論など)は目で読み、Mathlib
      の定理を使った通常の議論であることを確認しました。膨大な本体部分は読んでおらず、そこは Lean のカーネルによる検査に委ねます。
    </p>
  </Section>

  <Section id="checks" mark="§5" title="検査の内容と結果">
    <h3 class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <span class="font-serif font-normal text-primary">5.1</span>ソースの静的スキャン <Status state="ok" label="0 件" />
    </h3>
    <p>
      Lean を動かす前に、全ソース(1.03
      GB)を文字列検索しました。「証明済み」に見せかける抜け道になりうる記述と、ビルド時に任意のコードを実行しうる記述を数えています。
    </p>
    <Table>
      <thead>
        <tr>
          <th>検索対象</th>
          <th class="text-right">ファイル数</th>
          <th class="text-right">一致行数</th>
          <th>意味</th>
        </tr>
      </thead>
      <tbody>
        {
          scan.map(([target, files, lines, meaning]) => (
            <tr>
              <th class="w-[34%] align-top leading-relaxed font-normal" set:html={target} />
              <td class="num align-top">{files}</td>
              <td class="num align-top">{lines}</td>
              <td class="align-top leading-relaxed" set:html={meaning} />
            </tr>
          ))
        }
      </tbody>
    </Table>
    <p>
      メタプログラムを含むファイルは人間が読んで確認しました。<code>CutCptCopy.lean</code>
      は既存の定義・定理を、名前を付け替えて <code>addDecl</code> で登録し直すコマンドを定義しています。<code>addDecl</code>
      は通常どおりカーネル検査を経由するので、これ自体は健全性を損ないません。<code>OwnStruct.lean</code> と
      <code>HeckeNonvanishing/Imports.lean</code> は、項を組み立ててゴールに割り当てるタクティク(<code>kcopy</code>、<code
        >kexactB</code
      >)で、最終的な型の一致はカーネルが判定します。いずれも、後述のカーネル再検査の対象です。
    </p>
    <p class="text-sm text-base-content/70">
      静的スキャンは補助的な検査です。文字列検索をすり抜ける細工の可能性は残るため、最終判断はカーネルによる検査で行います。全項目の結果は
      <a href={`${repo}/tree/main/verification/static-scan`}><code>verification/static-scan/</code></a> にあります。
    </p>

    <h3 class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <span class="font-serif font-normal text-primary">5.2</span>依存ライブラリの真正性 <Status state="ok" label="完了" />
    </h3>
    <p>
      配布物が固定している Mathlib のコミット <code>0df444a360eaa60ab8c11dca51a86af692955474</code> は、公式リポジトリ
      <code>leanprover-community/mathlib4</code> のタグ <code>v4.33.1</code> と一致しました。<code>master</code>
      ブランチとの差は <code>lean-toolchain</code> の 1 行だけです。Batteries や Aesop など他の 8 つの依存も、Mathlib
      自身が固定している版と完全に一致します。改変された Mathlib を掴まされている、という可能性はありません。
    </p>

    <h3 class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <span class="font-serif font-normal text-primary">5.3</span>全モジュールのコンパイル <Status state="run" label="進行中" />
    </h3>
    <p>
      配布物の <code>lakefile.toml</code>・<code>lake-manifest.json</code>・<code>lean-toolchain</code>
      をそのまま使い、ソースに一切手を加えずに <code>lake build</code> を実行しています。Mathlib
      は公式のビルド済みキャッシュを取得して利用しました。
    </p>
    <Kv rows={buildRows} />
    <Note>
      ビルド手順に加えた工夫が 1 つあります。Lake 5 はモジュールごとに、推移的に import する全成果物のパスを列挙した
      <code class="font-mono text-[0.86em]">setup.json</code> を書き出します。<code class="font-mono text-[0.86em]">import Mathlib</code>
      だけで約 6 MB あり、このプロジェクト全体では合計 1.4 TB
      を超える見積もりになって検証機のディスクに収まりません。そこで、ビルド済みモジュールの
      <code class="font-mono text-[0.86em]">setup.json</code>
      を随時削除するスクリプトを並走させています。このファイルは Lean
      起動時の入力にすぎず、削除しても再ビルドが起きないこと(成果物として追跡されていないこと)を事前に小さな例で確認しました。ソース・設定・コンパイラには触れていません。
    </Note>

    <h3 class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <span class="font-serif font-normal text-primary">5.4</span>主定理が依存する公理 <Status state="wait" label="未実施" />
    </h3>
    <p>
      ビルド完了後、5 つの主定理それぞれについて <code>#print axioms</code> を実行します。Lean 4 と Mathlib の標準は
      <code>propext</code>・<code>Classical.choice</code>・<code>Quot.sound</code> の 3 つです。これ以外(<code>sorryAx</code>
      や独自公理)が現れた場合、その定理は無条件に証明されたとは言えません。
    </p>

    <h3 class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <span class="font-serif font-normal text-primary">5.5</span>主張の一致確認 <Status state="wait" label="未実施" />
    </h3>
    <p>
      検証者が Mathlib だけを import して書いた命題(<a href={`${repo}/blob/main/verification/lean-checks/RHReference.lean`}
        ><code>RHReference.lean</code></a
      >)を、配布物の主定理でそのまま証明できるかをカーネルに判定させます。あわせて、主定理の型に現れる定数を定義の中身まで推移的に辿り、主張がプロジェクト側の定義に依存していないことを機械的に確認します。
    </p>

    <h3 class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <span class="font-serif font-normal text-primary">5.6</span>カーネルによる再検査 <Status state="wait" label="未実施" />
    </h3>
    <p>
      ツールチェーン同梱の <code>leanchecker</code>
      で、全モジュールの宣言をカーネルに再生させます。エラボレータやメタプログラムを経由しない検査なので、カーネルを迂回して環境に宣言を押し込む細工があれば検出できます。公式キャッシュから取得した
      Mathlib 側のモジュールも同じ方法で再検査します。
    </p>

    <h3 class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <span class="font-serif font-normal text-primary">5.7</span>別実装のカーネルによる照合 <Status state="wait" label="未実施" />
    </h3>
    <p>
      ここまでの検査はすべて Lean 本体のカーネル(C++ 実装)に依存します。カーネル自体の不具合を突かれている可能性を減らすため、主定理 5
      件が推移的に依存する定義・定理・公理をすべて <code>lean4export</code> で書き出し、Rust で書かれた別実装の型検査器
      <code>nanoda</code> に検査させます。許可する公理は標準の 3 つだけです。
    </p>
    <p class="text-sm text-base-content/70">
      準備として、主張の定義 <code>RiemannZetaZerosOnLine</code>(Mathlib のみに依存)の依存一式を書き出して検査し、53,240
      宣言がエラーなく通ることを確認しました。使用した版は lean4export <code>v4.33.0</code>、nanoda_lib <code>0da9f98</code>(v0.4.32)です。
    </p>

    <h3 class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <span class="font-serif font-normal text-primary">5.8</span>ビルド後のソース不変確認 <Status state="wait" label="未実施" />
    </h3>
    <p>
      ビルドに使った 175,190 ファイルが原本と 1 バイトも違わないことを、保存してある SHA-256
      一覧と再照合します(ビルド開始前の照合は一致済み)。
    </p>
  </Section>

  <Section id="hardware" mark="§6" title="検証に使った計算機">
    <p>検証は 1 台の計算機で行っています。Lean のコンパイルとカーネル検査は CPU とメモリだけを使う処理で、GPU は関与しません。</p>
    <Kv rows={hardware} />
    <p class="text-sm text-base-content/70">
      採取した生の情報は <a href={`${repo}/blob/main/verification/hardware.txt`}><code>verification/hardware.txt</code></a> にあります。
    </p>
  </Section>

  <Section id="limits" mark="§7" title="この検証で言えること、言えないこと">
    <h3>すべての検査が通った場合に言えること</h3>
    <p>
      配布された Lean ソースが、指定どおりの Lean 4.33.1 と Mathlib v4.33.1 のもとでエラーなくコンパイルでき、主定理が標準の 3
      公理だけに依存している、ということです。Lean のカーネルが正しく、Mathlib の <code>riemannZeta</code>
      などの定義が意図どおりである限り、これは Mathlib の <code>RiemannHypothesis</code> が証明されたことを意味します。
    </p>
    <h3>言えないこと</h3>
    <ul>
      <li>証明の数学的な筋道が正しく理解できるか、既知の障害をどう越えているかは、この検証の対象外です。1,700 万行を人間が読んだわけではありません。</li>
      <li>Lean のカーネル実装そのものの正しさは前提としています。別実装のカーネル(nanoda)による照合は準備済みですが、この時点ではまだ行っていません。</li>
      <li>Mathlib 本体は公式のビルド済みキャッシュを使っています。ソースから再ビルドしてキャッシュと突き合わせる照合は、全検査の最後に予定しています。</li>
      <li>検証は 1 台の計算機、1 回の実行によるものです。</li>
      <li>配布元と著者については、PDF とサーバ応答から分かる範囲しか確認していません。</li>
    </ul>
  </Section>

  <Section id="reproduce" mark="§8" title="再現手順">
    <p>
      リポジトリには原本と、ここまでの全手順を再実行するスクリプトが入っています。<code>elan</code>、<code>zstd</code>、<code>ripgrep</code
      >、Python 3 が必要です。ビルド生成物の置き場所として数百 GB の空きを用意してください。
    </p>
    <CodeFile path="再現手順" note="bash" code={reproduce} lang="bash" />
  </Section>

