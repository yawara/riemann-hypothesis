// Mathlib v4.33.1 の RiemannHypothesis の定義(改行位置だけ変更)
const mathlibDef = `def RiemannHypothesis : Prop :=
  ∀ (s : ℂ)
  (_ : riemannZeta s = 0)
  (_ : ¬∃ n : ℕ, s = -2 * (n + 1))
  (_ : s ≠ 1),
  s.re = 1 / 2`;

