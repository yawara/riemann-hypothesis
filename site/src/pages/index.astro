import { fmtInt, jstMdHm } from '../lib/fmt';

const title = 'リーマン予想 Lean 証明の独立検証';
const description =
  'alpo.ge で公開されたリーマン予想の Lean 形式証明(175,187 ファイル・17,374,215 行・約 1.03 GB)を、原本を保全したうえで独立にコンパイル・検査している記録。';

const toc = [
  { id: 'summary', no: '1', title: '現時点の結論' },
  { id: 'observations', no: '2', title: '定点観測' },
  { id: 'target', no: '3', title: '検証対象' },
  { id: 'evidence', no: '4', title: '原本の保全' },
  { id: 'scale', no: '5', title: 'Lean コードの規模' },
  { id: 'statements', no: '6', title: '主定理の主張' },
  { id: 'checks', no: '7', title: '検査の内容と結果' },
  { id: 'hardware', no: '8', title: '検証に使った計算機' },
  { id: 'limits', no: '9', title: '言えること、言えないこと' },
  { id: 'reproduce', no: '10', title: '再現手順' },
];

const repo = 'https://github.com/yawara/riemann-hypothesis';
const obs = data.obs;
const latest = obs.latest;
const pct = ((latest.done / obs.total) * 100).toFixed(1);

// ---- 2 節: 速度が落ちていった理由(scripts/build_speed_analysis.py の集計) ----
const sp = data.speed; // ビルド完了後の集計
const snap = data.speedSnapshot; // ビルド途中(2026-11-21 21:10 JST)の集計。CPU の計測値と、当時の見積もりに使う
const spFirst = sp.intervals[0];
const spMid = sp.intervals.filter((i: { seq: number }) => i.seq >= 10 && i.seq <= 26);
const spMidMin = Math.floor(Math.min(...spMid.map((i: { rate_per_min: number }) => i.rate_per_min)) / 10) * 10;
const spMidMax = Math.ceil(Math.max(...spMid.map((i: { rate_per_min: number }) => i.rate_per_min)) / 10) * 10;
const spPeak = sp.intervals.reduce((a: any, b: any) => (b.closure_median > a.closure_median ? b : a));
const snapAsOf = jstMdHm(snap.as_of_utc);
const binLabel = (b: { lo: number; hi: number | null }) => (b.hi === null ? `${fmtInt(b.lo)} 以上` : `${fmtInt(b.lo)}〜${fmtInt(b.hi - 1)}`);
const man = (n: number) => (n / 10000).toFixed(1).replace(/\.0$/, '');
const perExternalMs = ((sp.regression.intercept_s / sp.external_modules) * 1000).toFixed(1);
const perProjectMs = sp.regression.slope_s_per_1000.toFixed(1);
// Main に至るいちばん深い鎖の最後の 8 個: 当てはめの見積もりと実際
const ct = sp.chain_tail;
const ctClosure = ct.map((t: { closure: number }) => t.closure);
const ctActual = ct.map((t: { actual_s: number }) => t.actual_s);
const ctPred = ct.map((t: { predicted_s: number }) => t.predicted_s);
const ctActualSumMin = Math.round(ctActual.reduce((a: number, b: number) => a + b, 0) / 60);
const round10 = (n: number) => Math.round(n / 10) * 10;
const snapTailHours = (snap.tail.reduce((sum: number, t: { predicted_s: number }) => sum + t.predicted_s, 0) / 3600).toFixed(1);

type St = 'ok' | 'run' | 'wait' | 'bad';
// ---- 1 節: 検査の一覧(実施順) ----
const checks: { state: St; label: string; title: string; detail: string; ref: string }[] = [
  { state: 'ok', label: '済', title: '原本の取得と保全', detail: 'PDF 1 個と Lean 配布物 14 分割を取得し、応答ヘッダ・取得時刻・SHA-256 とともに保存。', ref: '4' },
  { state: 'ok', label: '済', title: '配布物の完全性', detail: '14 分割を連結すると正常な gzip。中身は通常ファイルのみ 175,190 個で、危険なパスやリンクは無し。', ref: '4' },
  { state: 'ok', label: '済', title: 'ソースの静的スキャン', detail: '<code>sorry</code>・<code>axiom</code>・<code>native_decide</code>・<code>unsafe</code>、カーネル検査のスキップ指定などは、全ソース中に 0 件。', ref: '7.1' },
  { state: 'ok', label: '済', title: '依存ライブラリの真正性', detail: '固定された Mathlib のコミットは、公式リポジトリのタグ <code>v4.33.1</code> そのもの。他の依存も Mathlib 自身の固定版と一致。', ref: '7.2' },
  { state: 'ok', label: '済', title: 'import グラフ', detail: '存在しないモジュールへの import は 0、循環は 0。全 175,187 モジュールが <code>Main</code> から到達可能。', ref: '5' },
  { state: 'ok', label: '済', title: '全モジュールのコンパイル', detail: '2026-11-21 10:42 JST に開始し、11-22 9:22 に完走(22 時間 40 分)。全 175,187 モジュールでエラー 0。', ref: '7.3' },
  { state: 'run', label: '実行中', title: '主定理が依存する公理', detail: '5 つの主定理について <code>#print axioms</code> を実行中。', ref: '7.4' },
  { state: 'wait', label: '未着手', title: '主張の一致確認', detail: '検証者が Mathlib だけで書いた命題と、主定理の型が一致するかをカーネルに判定させる。', ref: '7.5' },
  { state: 'run', label: '実行中', title: 'カーネルによる再検査', detail: 'ツールチェーン同梱の <code>leanchecker</code> で、全モジュールの宣言をカーネルに再生させている。', ref: '7.6' },
  { state: 'wait', label: '未着手', title: '別実装のカーネルによる照合', detail: '主定理の依存一式を書き出し、Rust 製の別実装カーネル <code>nanoda</code> で検査する。道具は準備済み。', ref: '7.7' },
  { state: 'wait', label: '未着手', title: 'ビルド後のソース不変確認', detail: 'ビルドに使った全ファイルが、原本と 1 バイトも違わないことを再照合する。', ref: '7.8' },
];

// ---- 3 節 ----
const targetRows: [string, string][] = [
