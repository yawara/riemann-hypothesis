  { no: '2', name: 'lean.tar.gz.part01 〜 part14', size: '239,275,554', when: '10:25:45 〜 10:25:50', note: 'part01〜13 は各 18,000,000 バイト、part14 は 5,275,554 バイト。分割ごとの SHA-256 は <code>SHA256SUMS</code> に記録' },
  { no: '3', name: '連結した lean.tar.gz', size: '239,275,554', when: '—', hash: '9631b4f020199e580ba86178cb56c6e9b09f690c2369a80dc4334aa93f49c7fc' },
